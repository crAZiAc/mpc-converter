<Window x:Class="MpcConverter.App.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversion complete" Height="460" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Conversion complete" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0">
                <Run Text="Output: "/>
                <Run x:Name="PathRun" FontWeight="SemiBold"/>
            </TextBlock>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="Details">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Warnings" FontWeight="SemiBold" Margin="0,4,0,2"/>
                    <ItemsControl x:Name="WarningsList"/>
                    <TextBlock Text="Decisions" FontWeight="SemiBold" Margin="0,8,0,2"/>
                    <ItemsControl x:Name="DecisionsList"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Open output folder" Width="150" Click="OpenFolder_Click"/>
            <Button Content="Close" Width="90" Margin="8,0,0,0" IsCancel="True" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
