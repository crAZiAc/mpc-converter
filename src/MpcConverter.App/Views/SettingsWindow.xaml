<Window x:Class="MpcConverter.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="360" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <CheckBox Grid.Row="0" Content="Enable AI-assisted pad classification (Claude)"
                  IsChecked="{Binding AiEnabled}" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1" Text="Model" FontWeight="SemiBold"/>
        <ComboBox Grid.Row="2" ItemsSource="{Binding Models}" SelectedItem="{Binding Model}"
                  Margin="0,4,0,12" Width="260" HorizontalAlignment="Left"/>

        <TextBlock Grid.Row="3" Text="Claude API key (stored encrypted via Windows DPAPI)"
                   FontWeight="SemiBold"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,4">
            <PasswordBox x:Name="ApiKeyBox" Width="320"/>
            <Button Content="Clear stored key" Margin="8,0,0,0" Click="ClearKey_Click"/>
        </StackPanel>
        <TextBlock Grid.Row="5" Text="{Binding ApiKeyStatus}" Foreground="Gray" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="6" Orientation="Vertical">
            <TextBlock Text="Output folder (optional; defaults next to the source project)"
                       FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox Text="{Binding OutputFolder}" Width="360"/>
                <Button Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Width="90" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
