<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MpcConverter.Core\MpcConverter.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Produce "mpcconvert.exe" rather than "MpcConverter.Cli.exe". -->
    <AssemblyName>mpcconvert</AssemblyName>
    <!-- Defaults used when publishing a portable single-file exe (see README).
         These only take effect during `dotnet publish`, not normal build. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
